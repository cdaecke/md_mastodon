<?xml version="1.0"?>
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <mdmastodon_api>
            <ROOT>
                <sheetTitle>Settings</sheetTitle>
                <type>array</type>
                <el>
                    <settings.configId>
                        <label>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.plugin_api.configId</label>
                        <description>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.plugin_api.configId.description</description>
                        <config>
                            <type>group</type>
                            <allowed>tx_mdmastodon_domain_model_configuration</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                            <required>1</required>
                        </config>
                    </settings.configId>
                    <settings.limit>
                        <exclude>1</exclude>
                        <label>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.plugin_api.limit</label>
                        <description>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.plugin_api.limit.description</description>
                        <config>
                            <type>number</type>
                            <default>10</default>
                            <eval>trim</eval>
                            <range>
                                <lower>1</lower>
                                <upper>20</upper>
                            </range>
                            <slider>
                                <step>1</step>
                                <width>400</width>
                            </slider>
                        </config>
                    </settings.limit>
                    <settings.templateLayout>
                        <exclude>1</exclude>
                        <label>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.templateLayout</label>
                        <description>LLL:EXT:md_mastodon/Resources/Private/Language/locallang.xlf:flexforms.templateLayout.description</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <itemsProcFunc>Mediadreams\MdMastodon\Hooks\TemplateLayouts->user_templateLayout</itemsProcFunc>
                            <items>
                                <numIndex index="0">
                                    <label/>
                                    <value/>
                                </numIndex>
                            </items>
                        </config>
                    </settings.templateLayout>
                </el>
            </ROOT>
        </mdmastodon_api>
    </sheets>
</T3DataStructure>
